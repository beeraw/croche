# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Tests run on a throwaway SQLite file under var/. Contributors need no
# MariaDB, and no database outside `croche` is ever touched. A file rather than
# :memory: because the kernel reboots between requests in a functional test,
# and each reboot would otherwise open a fresh, empty in-memory database.
# The schema is built from the mapping, not from the MySQL-specific migrations.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
