{
    "name": "croche",
    "description": "Music notation web app for children",
    "packageManager": "yarn@4.18.0",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev-server": "encore dev-server",
        "dev": "encore dev",
        "watch": "encore dev --watch",
        "build": "encore production --progress",
        "test:e2e": "playwright test",
        "test:e2e:webkit": "playwright test --project=webkit",
        "lint:js": "eslint assets/ tests/e2e/",
        "lint:css": "stylelint 'assets/**/*.scss'",
        "lint": "yarn lint:js && yarn lint:css"
    },
    "devDependencies": {
        "@babel/core": "^8.0.7",
        "@babel/preset-env": "^8.0.7",
        "@eslint/js": "^10.0.1",
        "@hotwired/stimulus": "^3.2.2",
        "@playwright/test": "^1.64.1",
        "@symfony/stimulus-bridge": "^4.0.2",
        "@symfony/webpack-encore": "^7.2.0",
        "babel-plugin-polyfill-corejs3": "^1.0.0",
        "core-js": "^3.51.0",
        "eslint": "^10.13.0",
        "regenerator-runtime": "^0.14.1",
        "sass": "^1.106.1",
        "sass-loader": "^17.0.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "webpack": "^5.112.1",
        "webpack-cli": "^7.2.3"
    },
    "dependencies": {
        "driver.js": "^1.10.2",
        "vexflow": "^5.0.0"
    }
}
