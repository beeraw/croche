{% extends 'base.html.twig' %}

{% block title %}{{ 'security.who_plays'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="login">
        <div class="login__lang">{% include 'partial/_language.html.twig' with { locales: app_locales() } %}</div>

        <h1 class="login__title">{{ 'app.name'|trans }}</h1>
        <p class="login__subtitle">{{ 'security.pick_profile'|trans }}</p>

        <div class="container container--narrow">
            {% include 'partial/_flashes.html.twig' %}
        </div>

        {% if children is empty %}
            <p class="empty-state">{{ 'security.no_profile'|trans|nl2br }}</p>
        {% else %}
            <ul class="profile-grid">
                {% for child in children %}
                    <li>
                        <a class="profile-tile" href="{{ path('security.pin', { id: child.id }) }}">
                            {{ ux_icon('tabler:' ~ child.avatarIcon.value) }}
                            <span>{{ child.displayName }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <p class="login__footer">
            <a href="{{ path('security.login') }}">{{ 'nav.admin_area'|trans }}</a>
            ·
            <a href="{{ path('home') }}">{{ 'app.name'|trans }}</a>
        </p>
    </div>
{% endblock %}
