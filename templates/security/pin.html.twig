{% extends 'base.html.twig' %}

{% block title %}{{ profile.displayName }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="login">
        <div class="login__lang">{% include 'partial/_language.html.twig' with { locales: app_locales() } %}</div>

        <a class="login__back" href="{{ path('security.profiles') }}">
            {{ ux_icon('tabler:arrow-left') }}
            {{ 'security.change_profile'|trans }}
        </a>

        <div class="login__profile">
            {{ ux_icon('tabler:' ~ profile.avatarIcon.value) }}
            <strong>{{ profile.displayName }}</strong>
        </div>

        {% if lockedSeconds == 0 %}
            <div class="container container--narrow">
                {% include 'partial/_flashes.html.twig' %}
            </div>
        {% endif %}

        {% if lockedSeconds > 0 %}
            <p class="alert alert--error">
                {{ 'security.pin_locked_minutes'|trans({ '{minutes}': (lockedSeconds / 60)|round(0, 'ceil') }) }}
            </p>
        {% else %}
            <p class="login__subtitle">{{ 'security.enter_pin'|trans }}</p>

            <form class="pin-pad"
                  method="post"
                  action="{{ path('security.pin_check', { id: profile.id }) }}"
                  data-controller="pin-pad"
                  data-pin-pad-length-value="4">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('pin_code') }}">
                <input type="hidden" name="pin" data-pin-pad-target="input">

                <div class="pin-pad__dots" role="status" aria-live="polite"
                     aria-label="{{ 'security.digits_entered'|trans }}">
                    {% for i in 1..4 %}
                        <span class="pin-pad__dot" data-pin-pad-target="dot"></span>
                    {% endfor %}
                </div>

                <div class="pin-pad__keys">
                    {% for digit in 1..9 %}
                        <button type="button" class="pin-pad__key"
                                data-action="pin-pad#press" data-digit="{{ digit }}">{{ digit }}</button>
                    {% endfor %}

                    <button type="button" class="pin-pad__key pin-pad__key--action"
                            data-action="pin-pad#clear" aria-label="{{ 'security.clear_all'|trans }}">
                        {{ ux_icon('tabler:x') }}
                    </button>

                    <button type="button" class="pin-pad__key"
                            data-action="pin-pad#press" data-digit="0">0</button>

                    <button type="button" class="pin-pad__key pin-pad__key--action"
                            data-action="pin-pad#backspace" aria-label="{{ 'security.erase_one'|trans }}">
                        {{ ux_icon('tabler:backspace') }}
                    </button>
                </div>
            </form>
        {% endif %}
    </div>
{% endblock %}
