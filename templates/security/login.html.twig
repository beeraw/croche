{% extends 'base.html.twig' %}

{% block title %}{{ 'security.admin_title'|trans }} — {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="login">
        <div class="login__lang">{% include 'partial/_language.html.twig' with { locales: app_locales() } %}</div>

        <a class="login__back" href="{{ path('security.profiles') }}">
            {{ ux_icon('tabler:arrow-left') }}
            {{ 'security.back_to_profiles'|trans }}
        </a>

        <h1 class="login__title">{{ 'security.admin_title'|trans }}</h1>

        <div class="login__panel">
            {% if error %}
                <p class="alert alert--error">{{ 'security.bad_credentials'|trans }}</p>
            {% endif %}

            <form method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <label class="field">
                    <span class="field__label">{{ 'security.username'|trans }}</span>
                    <input class="input" type="text" name="_username" value="{{ lastUsername }}"
                           autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                </label>

                <label class="field">
                    <span class="field__label">{{ 'security.password'|trans }}</span>
                    <input class="input" type="password" name="_password"
                           autocomplete="current-password" required>
                </label>

                <button class="btn btn--block btn--lg" type="submit">{{ 'security.sign_in'|trans }}</button>
            </form>
        </div>
    </div>
{% endblock %}
