{% set user = app.user %}
<header class="navbar no-print">
    <div class="container container--wide">
        <div class="navbar__inner">
            <a class="navbar__brand" href="{{ path('home') }}">
                {{ ux_icon('tabler:music') }}
                {{ 'app.name'|trans }}
            </a>

            <nav class="navbar__nav">
                {% if user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        <a class="navbar__link" href="{{ path('admin.user.index') }}">
                            {{ ux_icon('tabler:users') }}
                            <span>{{ 'nav.profiles'|trans }}</span>
                        </a>
                        <a class="navbar__link" href="{{ path('admin.score.index') }}">
                            {{ ux_icon('tabler:music') }}
                            <span>{{ 'nav.scores'|trans }}</span>
                        </a>
                    {% else %}
                        <a class="navbar__link" href="{{ path('score.index') }}">
                            {{ ux_icon('tabler:home') }}
                            <span>{{ 'nav.my_scores'|trans }}</span>
                        </a>
                    {% endif %}

                    <span class="navbar__user">
                        {{ ux_icon('tabler:' ~ user.avatarIcon.value) }}
                        <span>{{ user.displayName }}</span>
                    </span>
                {% endif %}

                {# Screens with a guided tour ask for the button by passing a
                   tour name; the others simply do not show one. #}
                {% if tour is defined %}
                    {% include 'partial/_tour_button.html.twig'
                        with { name: tour, class: 'navbar__link' } only %}
                {% endif %}

                {% include 'partial/_language.html.twig' with { locales: app_locales() } %}

                {% if user %}
                    <a class="navbar__link" href="{{ path('security.logout') }}"
                       title="{{ 'nav.sign_out'|trans }}">
                        {{ ux_icon('tabler:logout') }}
                        <span class="visually-hidden">{{ 'nav.sign_out'|trans }}</span>
                    </a>
                {% endif %}
            </nav>
        </div>
    </div>
</header>
