{% extends 'layout.html.twig' %}

{% block title %}Profils — Croche{% endblock %}
{% block container_class %}container--wide{% endblock %}

{% block content %}
    <div class="page-header">
        <h1 class="page-header__title">Profils</h1>

        <a class="btn" href="{{ path('admin.user.create') }}">
            {{ ux_icon('tabler:plus') }}
            Nouveau profil enfant
        </a>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th>Prénom</th>
                <th>Identifiant</th>
                <th>Rôle</th>
                <th>Morceaux</th>
                <th>État</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for profile in users %}
                <tr>
                    <td>
                        <span class="cluster">
                            <span class="avatar">{{ ux_icon('tabler:' ~ profile.avatarIcon.value) }}</span>
                            <strong>{{ profile.displayName }}</strong>
                        </span>
                    </td>
                    <td>{{ profile.username }}</td>
                    <td>
                        {% if profile.admin %}
                            <span class="badge badge--admin">Administrateur</span>
                        {% else %}
                            <span class="badge badge--child">Enfant</span>
                        {% endif %}
                    </td>
                    <td>{{ profile.scores|length }}</td>
                    <td>
                        {% if profile.pinLocked %}
                            <form method="post" action="{{ path('admin.user.unlock', { id: profile.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('user-unlock' ~ profile.id) }}">
                                <button class="btn btn--ghost" type="submit">
                                    {{ ux_icon('tabler:lock-open') }}
                                    Débloquer
                                </button>
                            </form>
                        {% elseif profile.pinFailedAttempts > 0 %}
                            <span class="text-muted">{{ profile.pinFailedAttempts }} essai(s) raté(s)</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="table__actions">
                            {% if not profile.admin %}
                                <a class="btn-icon" href="{{ path('admin.user.edit', { id: profile.id }) }}"
                                   title="Modifier" aria-label="Modifier">
                                    {{ ux_icon('tabler:pencil') }}
                                </a>
                                <a class="btn-icon" href="{{ path('admin.user.reset_pin', { id: profile.id }) }}"
                                   title="Réinitialiser le code" aria-label="Réinitialiser le code">
                                    {{ ux_icon('tabler:key') }}
                                </a>
                            {% endif %}

                            {% if profile.id != app.user.id %}
                                <form method="post" action="{{ path('admin.user.delete', { id: profile.id }) }}"
                                      data-controller="confirm"
                                      data-confirm-message-value="Supprimer « {{ profile.displayName }} » et toutes ses partitions ?">
                                    <input type="hidden" name="_token" value="{{ csrf_token('user-delete' ~ profile.id) }}">
                                    <button class="btn-icon btn-icon--danger" type="submit"
                                            title="Supprimer" aria-label="Supprimer">
                                        {{ ux_icon('tabler:trash') }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
