{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin.profiles'|trans }} — {{ 'app.name'|trans }}{% endblock %}
{% block container_class %}container--wide{% endblock %}

{% block content %}
    <div class="page-header">
        <h1 class="page-header__title">{{ 'admin.profiles'|trans }}</h1>

        <a class="btn" href="{{ path('admin.user.create') }}">
            {{ ux_icon('tabler:plus') }}
            {{ 'admin.new_child'|trans }}
        </a>
    </div>

    <div class="table-wrap">
        <table class="table">
            <thead>
            <tr>
                <th>{{ 'admin.first_name'|trans }}</th>
                <th>{{ 'admin.username'|trans }}</th>
                <th>{{ 'admin.role'|trans }}</th>
                <th>{{ 'admin.scores_count'|trans }}</th>
                <th>{{ 'admin.state'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for profile in users %}
                <tr>
                    <td>
                        <span class="cluster">
                            <span class="avatar">{{ ux_icon('tabler:' ~ profile.avatarIcon.value) }}</span>
                            <strong>{{ profile.displayName }}</strong>
                        </span>
                    </td>
                    <td>{{ profile.username }}</td>
                    <td>
                        {% if profile.admin %}
                            <span class="badge badge--admin">{{ 'admin.role_admin'|trans }}</span>
                        {% else %}
                            <span class="badge badge--child">{{ 'admin.role_child'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>{{ profile.scores|length }}</td>
                    <td>
                        {% if profile.pinLocked %}
                            <form method="post" action="{{ path('admin.user.unlock', { id: profile.id }) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('user-unlock' ~ profile.id) }}">
                                <button class="btn btn--ghost" type="submit">
                                    {{ ux_icon('tabler:lock-open') }}
                                    {{ 'admin.unlock'|trans }}
                                </button>
                            </form>
                        {% elseif profile.pinFailedAttempts > 0 %}
                            <span class="text-muted">
                                {{ 'admin.failed_attempts'|trans({ '%count%': profile.pinFailedAttempts }) }}
                            </span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="table__actions">
                            {% if not profile.admin %}
                                <a class="btn-icon" href="{{ path('admin.user.edit', { id: profile.id }) }}"
                                   title="{{ 'admin.edit'|trans }}" aria-label="{{ 'admin.edit'|trans }}">
                                    {{ ux_icon('tabler:pencil') }}
                                </a>
                                <a class="btn-icon" href="{{ path('admin.user.reset_pin', { id: profile.id }) }}"
                                   title="{{ 'admin.reset_pin'|trans }}" aria-label="{{ 'admin.reset_pin'|trans }}">
                                    {{ ux_icon('tabler:key') }}
                                </a>
                            {% endif %}

                            {% if profile.id != app.user.id %}
                                <form method="post" action="{{ path('admin.user.delete', { id: profile.id }) }}"
                                      data-controller="confirm"
                                      data-confirm-message-value="{{ 'admin.delete_profile_confirm'|trans({ '%name%': profile.displayName }) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('user-delete' ~ profile.id) }}">
                                    <button class="btn-icon btn-icon--danger" type="submit"
                                            title="{{ 'admin.delete'|trans }}" aria-label="{{ 'admin.delete'|trans }}">
                                        {{ ux_icon('tabler:trash') }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
