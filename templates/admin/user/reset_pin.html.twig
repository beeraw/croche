{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin.pin_of'|trans({ '%name%': profile.displayName }) }} — {{ 'app.name'|trans }}{% endblock %}
{% block container_class %}container--narrow{% endblock %}

{% block content %}
    <div class="page-header">
        <h1 class="page-header__title">{{ 'admin.pin_of'|trans({ '%name%': profile.displayName }) }}</h1>
    </div>

    <div class="card">
        <p class="text-muted">{{ 'admin.pin_help'|trans }}</p>

        {{ form_start(form) }}
            <div class="field">
                {{ form_label(form.pin, null, { label_attr: { class: 'field__label' } }) }}
                {{ form_widget(form.pin, { attr: { class: 'input' } }) }}
                <div class="field__errors">{{ form_errors(form.pin) }}</div>
            </div>

            <div class="cluster">
                <button class="btn btn--lg" type="submit">{{ 'admin.save_pin'|trans }}</button>
                <a class="btn btn--ghost" href="{{ path('admin.user.index') }}">{{ 'admin.cancel'|trans }}</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
