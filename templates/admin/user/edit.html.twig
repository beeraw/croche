{% extends 'layout.html.twig' %}

{% block title %}{{ profile.displayName }} — Croche{% endblock %}
{% block container_class %}container--narrow{% endblock %}

{% block content %}
    <div class="page-header">
        <h1 class="page-header__title">Modifier « {{ profile.displayName }} »</h1>
    </div>

    <div class="card">
        {{ include('admin/user/_form.html.twig', { button: 'Enregistrer' }) }}
    </div>

    <p class="text-muted form-footnote">
        Pour changer le code à 4 chiffres,
        <a href="{{ path('admin.user.reset_pin', { id: profile.id }) }}">réinitialisez-le</a>.
    </p>
{% endblock %}
