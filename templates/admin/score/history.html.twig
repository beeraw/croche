{% extends 'layout.html.twig' %}

{% block title %}{{ 'admin.history_title'|trans }} — {{ score.title }}{% endblock %}

{% block content %}
    <div class="page-header">
        <div>
            <h1 class="page-header__title">{{ 'admin.history_title'|trans }}</h1>
            <p class="text-muted">{{ score.title }} — {{ score.owner.displayName }}</p>
        </div>

        <a class="btn btn--ghost" href="{{ path('admin.score.index') }}">
            {{ ux_icon('tabler:arrow-left') }}
            {{ 'admin.back'|trans }}
        </a>
    </div>

    <p class="text-muted">{{ 'admin.history_intro'|trans({ '%keep%': keep }) }}</p>

    {% if revisions is empty %}
        <p class="empty-state">{{ 'admin.no_history'|trans }}</p>
    {% else %}
        <div class="table-wrap">
            <table class="table">
                <thead>
                <tr>
                    <th>{{ 'admin.version'|trans }}</th>
                    <th>{{ 'admin.saved_at'|trans }}</th>
                    <th>{{ 'editor.measures'|trans }}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for revision in revisions %}
                    {% set measures = revision.content.staves[0].measures|default([])|length %}
                    <tr>
                        <td>#{{ loop.revindex }}</td>
                        <td>{{ revision.createdAt|format_datetime('short', 'short') }}</td>
                        <td>{{ measures }}</td>
                        <td>
                            <div class="table__actions">
                                <form method="post"
                                      action="{{ path('admin.score.restore', { id: score.id, revision: revision.id }) }}"
                                      data-controller="confirm"
                                      data-confirm-message-value="{{ 'admin.restore_confirm'|trans }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('score-restore' ~ revision.id) }}">
                                    <button class="btn btn--ghost" type="submit">
                                        {{ ux_icon('tabler:arrow-back-up') }}
                                        {{ 'admin.restore'|trans }}
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
