{#
  Bravura glyphs are used for the duration and rest buttons: VexFlow already
  loads that font, so these cost nothing extra.
#}
{% set durations = [
    { value: 'w', glyph: '&#xE1D2;', label: 'editor.whole' },
    { value: 'h', glyph: '&#xE1D3;', label: 'editor.half' },
    { value: 'q', glyph: '&#xE1D5;', label: 'editor.quarter' },
    { value: '8', glyph: '&#xE1D7;', label: 'editor.eighth' },
] %}

<div class="editor__tools no-print" data-controller="note-palette">
    <div class="tool-group"
         data-tour-step="3"
         data-tour-title="{{ 'tour.editor.stave.title'|trans }}"
         data-tour-text="{{ 'tour.editor.stave.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.stave'|trans }}</span>
        <div class="stave-switch" role="group" aria-label="{{ 'editor.active_stave'|trans }}">
            <button type="button" class="stave-switch__btn is-active"
                    data-score-editor-target="staveButton"
                    data-stave="0"
                    data-action="score-editor#selectStave">{{ 'editor.stave_treble'|trans }}</button>
            <button type="button" class="stave-switch__btn"
                    data-score-editor-target="staveButton"
                    data-stave="1"
                    data-action="score-editor#selectStave">{{ 'editor.stave_bass'|trans }}</button>
        </div>
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group" role="group" aria-label="{{ 'editor.duration'|trans }}"
         data-tour-step="4"
         data-tour-title="{{ 'tour.editor.duration.title'|trans }}"
         data-tour-text="{{ 'tour.editor.duration.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.duration'|trans }}</span>
        {% for duration in durations %}
            <button type="button"
                    class="tool-btn {{ duration.value == 'q' ? 'is-active' : '' }}"
                    data-note-palette-target="duration"
                    data-duration="{{ duration.value }}"
                    data-action="note-palette#selectDuration"
                    title="{{ duration.label|trans }}" aria-label="{{ duration.label|trans }}">
                <span class="tool-btn__glyph {{ duration.value == 'w' ? '' : 'tool-btn__glyph--stemmed' }}"
                      aria-hidden="true">{{ duration.glyph|raw }}</span>
            </button>
        {% endfor %}
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group" role="group" aria-label="{{ 'editor.accidental'|trans }}"
         data-tour-step="9"
         data-tour-title="{{ 'tour.editor.accidental.title'|trans }}"
         data-tour-text="{{ 'tour.editor.accidental.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.accidental'|trans }}</span>
        {% for accidental in [
            { value: '#', label: 'editor.sharp', sign: '♯' },
            { value: 'b', label: 'editor.flat', sign: '♭' },
            { value: 'n', label: 'editor.natural', sign: '♮' },
        ] %}
            <button type="button" class="tool-btn"
                    data-note-palette-target="accidental"
                    data-accidental="{{ accidental.value }}"
                    data-action="note-palette#toggleAccidental"
                    title="{{ accidental.label|trans }}" aria-label="{{ accidental.label|trans }}">
                <span class="tool-btn__text" aria-hidden="true">{{ accidental.sign }}</span>
            </button>
        {% endfor %}
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group"
         data-tour-step="10"
         data-tour-title="{{ 'tour.editor.rest.title'|trans }}"
         data-tour-text="{{ 'tour.editor.rest.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.rest'|trans }}</span>
        <button type="button" class="tool-btn"
                data-note-palette-target="rest"
                data-action="note-palette#toggleRest"
                title="{{ 'editor.place_rest'|trans }}" aria-label="{{ 'editor.place_rest'|trans }}">
            <span class="tool-btn__glyph tool-btn__glyph--rest" aria-hidden="true">&#xE4E5;</span>
        </button>
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group"
         data-tour-step="11"
         data-tour-title="{{ 'tour.editor.delete.title'|trans }}"
         data-tour-text="{{ 'tour.editor.delete.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.note'|trans }}</span>
        <button type="button" class="btn-icon btn-icon--danger"
                data-score-editor-target="deleteButton"
                data-action="score-editor#deleteSelection"
                title="{{ 'editor.delete_note'|trans }}" aria-label="{{ 'editor.delete_note'|trans }}">
            {{ ux_icon('tabler:trash') }}
        </button>
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group"
         data-tour-step="12"
         data-tour-title="{{ 'tour.editor.measures.title'|trans }}"
         data-tour-text="{{ 'tour.editor.measures.text'|trans }}"
         data-tour-side="top">
        <span class="tool-group__label">{{ 'editor.measures'|trans }}</span>
        <button type="button" class="btn-icon"
                data-action="score-editor#removeMeasure"
                title="{{ 'editor.remove_measure'|trans }}" aria-label="{{ 'editor.remove_measure'|trans }}">
            {{ ux_icon('tabler:square-minus') }}
        </button>
        <span class="tempo__value" data-score-editor-target="measureCount">4</span>
        <button type="button" class="btn-icon"
                data-action="score-editor#addMeasure"
                title="{{ 'editor.add_measure'|trans }}" aria-label="{{ 'editor.add_measure'|trans }}">
            {{ ux_icon('tabler:square-plus') }}
        </button>
    </div>

    <span class="tool-group__sep" aria-hidden="true"></span>

    <div class="tool-group tempo"
         data-tour-step="13"
         data-tour-title="{{ 'tour.editor.tempo.title'|trans }}"
         data-tour-text="{{ 'tour.editor.tempo.text'|trans }}"
         data-tour-side="top" data-tour-align="end">
        <span class="tool-group__label">{{ 'editor.tempo'|trans }}</span>
        {{ ux_icon('tabler:metronome') }}
        <input class="tempo__input"
               type="range"
               min="{{ schema.tempoMin }}"
               max="{{ schema.tempoMax }}"
               step="2"
               value="{{ score.content.tempo|default(90) }}"
               aria-label="{{ 'editor.tempo'|trans }}"
               data-playback-target="tempoInput"
               data-action="input->playback#tempoChanged">
        <span class="tempo__value" data-playback-target="tempoValue">{{ score.content.tempo|default(90) }} bpm</span>
    </div>
</div>
