{% extends 'base.html.twig' %}

{% block title %}{{ score.title }} — {{ 'app.name'|trans }}{% endblock %}
{% block body_class %}is-editor{% endblock %}

{#
  Every string the JavaScript shows is translated here and handed over as data.
  The catalogue stays the single source of truth, and the bundle needs no
  translation library of its own.
#}
{% set editorMessages = {
    measureFull: 'editor.notice.measure_full'|trans,
    allFull: 'editor.notice.all_full'|trans,
    maxMeasures: 'editor.notice.max_measures'|trans({ '%count%': schema.maxMeasures }),
    lastMeasure: 'editor.notice.last_measure'|trans,
    notEmpty: 'editor.notice.not_empty'|trans,
    recovered: 'editor.recovered'|trans,
    durations: {
        w: 'editor.duration_name.w'|trans,
        h: 'editor.duration_name.h'|trans,
        q: 'editor.duration_name.q'|trans,
        '8': 'editor.duration_name.8'|trans,
    },
} %}

{% set autosaveMessages = {
    saved: 'editor.saved'|trans,
    saving: 'editor.saving'|trans,
    modified: 'editor.modified'|trans,
    offline: 'editor.offline'|trans,
} %}

{% set playbackMessages = {
    play: 'editor.play'|trans,
    stop: 'editor.stop'|trans,
    nothingToPlay: 'editor.notice.nothing_to_play'|trans,
} %}

{% block body %}
    <div class="editor"
         data-controller="score-editor autosave playback"
         data-action="note-palette:change->score-editor#toolChanged
                      piano-keyboard:press->score-editor#pianoPressed
                      piano-keyboard:release->score-editor#pianoReleased"
         data-score-editor-content-value="{{ score.content|json_encode|e('html_attr') }}"
         data-score-editor-schema-value="{{ schema|json_encode|e('html_attr') }}"
         data-score-editor-messages-value="{{ editorMessages|json_encode|e('html_attr') }}"
         data-autosave-url-value="{{ path('api.score.update', { id: score.id }) }}"
         data-autosave-token-value="{{ csrf_token('score-api') }}"
         data-autosave-storage-key-value="croche.score.{{ score.id }}"
         data-autosave-messages-value="{{ autosaveMessages|json_encode|e('html_attr') }}"
         data-playback-tempo-value="{{ score.content.tempo|default(90) }}"
         data-playback-messages-value="{{ playbackMessages|json_encode|e('html_attr') }}">

        {% include 'score/_editor_bar.html.twig' %}

        <div class="editor__stage" data-score-editor-target="stage">
            <div class="editor__print-header print-only">
                <h1 class="editor__print-title" data-score-editor-target="printTitle">{{ score.title }}</h1>
                <p class="editor__print-author">{{ score.owner.displayName }}</p>
            </div>

            <div class="score-sheet"
                 data-tour-step="6"
                 data-tour-title="{{ 'tour.editor.sheet.title'|trans }}"
                 data-tour-text="{{ 'tour.editor.sheet.text'|trans }}"
                 data-tour-side="bottom" data-tour-align="center">
                <div class="score-sheet__canvas"
                     data-score-editor-target="canvas"
                     data-action="pointerdown->score-editor#stageTapped"></div>
                <div class="playhead" data-playback-target="playhead"></div>
            </div>

            <p class="editor__notice" role="status" aria-live="polite"
               data-score-editor-target="notice"></p>
        </div>

        {% include 'score/_editor_tools.html.twig' %}
        {% include 'score/_piano.html.twig' %}
    </div>
{% endblock %}
